---
import FormattedDate from '../../components/FormattedDate.astro';
import { profile } from '../../data/profile';
import Page from '../../layouts/Page.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---
<Page title="Notes — Rizky Kay" description="Notes from Rizky Kay (morizkay) on building software, developer tools, and working with AI agents.">
  <header class="page-head">
    <h1>Notes</h1>
    <p>Write-ups on things I’ve built and learned. Subscribe with <a class="link" href="/rss.xml">RSS</a>.</p>
  </header>
  {posts.length > 0 ? (
    <ol class="post-index page-list">{posts.map(post => (
      <li><a class="post-row" href={`/blog/${post.id}/`}><FormattedDate date={post.data.pubDate} /><div><h2>{post.data.title}</h2><p>{post.data.description}</p></div></a></li>
    ))}</ol>
  ) : (
    <section class="empty page-list" aria-label="No notes yet">
      <p>Nothing published yet.</p>
      <p>In the meantime, see the <a class="link" href="/projects/">projects</a> or follow along on <a class="link" href={profile.bluesky}>Bluesky</a>.</p>
    </section>
  )}
</Page>
