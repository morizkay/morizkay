---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import Contact from '../components/Contact.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Icon from '../components/Icon.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import { profile } from '../data/profile';
import Page from '../layouts/Page.astro';
import { getPublishedPosts } from '../lib/posts';

const posts = (await getPublishedPosts()).slice(0, 3);
---
<Page>
  <section class="intro" aria-labelledby="intro-title">
    <div class="identity">
      <Image src={avatar} alt={`Portrait of ${profile.name}`} width={96} height={96} loading="eager" />
      <div><strong>{profile.name}</strong><span>@{profile.handle}</span></div>
    </div>
    <h1 id="intro-title">I’m Rizky, a software developer. <span class="dim">I build developer tools, design systems, and the glue between AI agents and the tools we already use.</span></h1>
    <p class="intro-text">I work at Tictag and maintain <a class="link" href="https://github.com/efektif">Efektif</a>, a React design system. Outside work I publish small, practical tools: a self-hosted LLM gateway, editor and agent integrations, local development utilities, and plugins for my Linux desktop.</p>
    <dl class="facts">
      <div><dt>Based in</dt><dd>{profile.location}</dd></div>
      <div><dt>Working on</dt><dd>Tictag · Efektif</dd></div>
      <div><dt>Timezone</dt><dd>{profile.timezone}</dd></div>
    </dl>
  </section>

  <section id="work" class="section" aria-labelledby="work-title">
    <div class="section-head"><h2 id="work-title">Selected projects</h2><a class="arrow-link" href="/projects/">Details and install <Icon name="arrow" size={14} /></a></div>
    <ProjectIndex />
  </section>

  {posts.length > 0 && (
    <section class="section" aria-labelledby="notes-title">
      <div class="section-head"><h2 id="notes-title">Recent notes</h2><a class="arrow-link" href="/blog/">All notes <Icon name="arrow" size={14} /></a></div>
      <ol class="post-index">{posts.map(post => (
        <li><a class="post-row" href={`/blog/${post.id}/`}><FormattedDate date={post.data.pubDate} /><div><h3>{post.data.title}</h3><p>{post.data.description}</p></div></a></li>
      ))}</ol>
    </section>
  )}

  <Contact />
</Page>
