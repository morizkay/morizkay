---
import { links, profile } from '../data/profile';
import Icon from './Icon.astro';
---
<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div>
    <h2 id="contact-title">Get in touch</h2>
    <p>About one of my projects, a package, or something you’re building. Email is the best way to reach me.</p>
    <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}<Icon name="arrow" size={18} /></a>
  </div>
  <ul class="elsewhere" aria-label="Elsewhere">
    {links.map(link => <li><a href={link.href} rel="me"><span>{link.label}</span><span class="mono">{link.handle}</span><Icon name="arrow" size={14} /></a></li>)}
  </ul>
</section>
